[Unit]
Description=Todo API Application
After=network.target

[Service]
Type=simple
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_directory }}
ExecStart=/usr/bin/java -jar {{ app_directory }}/todo-api.jar --server.port={{ app_port }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
